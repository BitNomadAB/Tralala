# Copy to .env and adjust. Never commit real secrets.

# Session-signing secret (at least 32 characters). Optional: when unset, weak or shorter,
# a unique secret is generated once and stored in <data>/.session-secret.
TRALALA_SECRET_KEY=change-me-to-a-long-random-string

# Set when you rotate TRALALA_SECRET_KEY: keys sealed with the old secret are re-sealed with the
# new one at startup, after which this value can be removed.
# TRALALA_PREVIOUS_SECRET_KEY=

# Bootstrap administrator created on first start (only if no user exists).
# If the password is empty or a published placeholder, a random one is written to
# <data>/.bootstrap-password. Delete that file after the first sign-in.
TRALALA_BOOTSTRAP_USERNAME=admin
TRALALA_BOOTSTRAP_PASSWORD=change-me

# Minimum password length for accounts; 8 is the floor (default 8).
TRALALA_PASSWORD_MIN_LENGTH=8

# Days until a new API token expires; 0 means it never expires (default 90).
TRALALA_CREDENTIAL_DEFAULT_TTL_DAYS=90

# Trust X-Forwarded-For for the client address used by the sign-in throttle. Only enable this
# behind a reverse proxy you control.
TRALALA_TRUST_PROXY_HEADERS=false

# Set true when serving over HTTPS so cookies are marked Secure.
TRALALA_COOKIE_SECURE=false

# Comma separated list of allowed browser origins (empty for same-origin deployments).
TRALALA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage location for registry, board databases and backups.
TRALALA_DATA_DIR=./data

# Limits and defaults.
TRALALA_SESSION_TTL_SECONDS=43200
TRALALA_MAX_REQUEST_BYTES=8388608
TRALALA_RATE_LIMIT_PER_MINUTE=600
TRALALA_BOARD_IDLE_CLOSE_SECONDS=300
TRALALA_DEFAULT_LISTS=Backlog,Todo,In Progress,Review,Done
TRALALA_BULK_LIMIT=100
TRALALA_ENABLE_DOCS=true
# Require a signed-in session for /docs and /openapi.json.
TRALALA_DOCS_REQUIRE_AUTH=true

# Port published by docker compose.
TRALALA_HTTP_PORT=8080
