# Copy to .env and adjust. Never commit real secrets.

# Session-signing secret (at least 32 characters). Optional: when unset, weak or shorter,
# a unique secret is generated once and stored in <data>/.session-secret.
TRALALA_SECRET_KEY=change-me-to-a-long-random-string

# Set when you rotate TRALALA_SECRET_KEY: keys sealed with the old secret are re-sealed with the
# new one at startup, after which this value can be removed.
# TRALALA_PREVIOUS_SECRET_KEY=

# Bootstrap administrator created on first start (only if no user exists).
# If the password is empty or a published placeholder, a random one is written to
# <data>/.bootstrap-password. Delete that file after the first sign-in.
TRALALA_BOOTSTRAP_USERNAME=admin
# Leave this empty for a unique password: the server generates one on first start and writes it to
# <data>/.bootstrap-password (owner-only). Set a value only for a disposable local test install, and
# never a published one: admin/password/change-me/changeme/tralala-dev-1 are all treated as empty.
TRALALA_BOOTSTRAP_PASSWORD=

# Minimum password length for accounts; 8 is the floor (default 8).
TRALALA_PASSWORD_MIN_LENGTH=8

# Days until a new API token expires; 0 means it never expires (default 90).
TRALALA_CREDENTIAL_DEFAULT_TTL_DAYS=90

# Trust X-Forwarded-For for the client address used by the sign-in throttle. Only enable this
# behind a reverse proxy you control.
TRALALA_TRUST_PROXY_HEADERS=false

# Set true when serving over HTTPS so cookies are marked Secure.
TRALALA_COOKIE_SECURE=false

# Comma separated list of allowed browser origins (empty for same-origin deployments).
TRALALA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage location for registry, board databases and backups.
TRALALA_DATA_DIR=./data

# Limits and defaults.
TRALALA_SESSION_TTL_SECONDS=43200
# Every request body, including an upload, is bounded by this. The attachment default is the same
# number on purpose: a file cannot be larger than the body that carries it. Raise both together.
TRALALA_MAX_REQUEST_BYTES=8388608
TRALALA_RATE_LIMIT_PER_MINUTE=600
TRALALA_BOARD_IDLE_CLOSE_SECONDS=300

# The dashboard counts Loops, lists and Tickets per board. The numbers live in each board's own
# database, so they are cached in the registry and re-measured when a board is written to. This
# value is only a backstop for a board file changed outside the app; 0 measures on every list.
TRALALA_BOARD_COUNTS_CACHE_SECONDS=60
TRALALA_DEFAULT_LISTS=Backlog,Todo,In Progress,Review,Done
TRALALA_BULK_LIMIT=100
# Discussions: a run is capped at four rounds, and a caller who sends no budget gets these. Set
# either budget to 0 to disable that default. Raising the round value above 4 has no effect: the API
# rejects a request for more than four rounds.
TRALALA_DISCUSSION_MAX_ROUNDS=4
TRALALA_DISCUSSION_TOKEN_BUDGET=200000
TRALALA_DISCUSSION_TIME_BUDGET_SECONDS=900
# How the host filesystem behaves. `auto` follows the operating system; `windows` retries the
# sharing violation a virus scanner or indexer causes; `posix` does not expect one; `network` adds
# the transient EBUSY/ENOTEMPTY retries an NFS/SMB share needs. It only selects retry policy — the
# file-locking mechanism always follows the real operating system.
TRALALA_PLATFORM_PROFILE=auto
# A board archive is limited after decompression as well: the database member may not expand past
# this many bytes.
TRALALA_BOARD_IMPORT_MAX_BYTES=268435456
# The lowest level the backend log writes (one JSON object per line): DEBUG, INFO, WARNING or ERROR.
TRALALA_LOG_LEVEL=INFO
TRALALA_ENABLE_DOCS=true
# Require a signed-in session for /docs and /openapi.json.
TRALALA_DOCS_REQUIRE_AUTH=true

# Web tier (Caddy, in the frontend image). A bare `:80` serves plain HTTP, which is right behind
# Tailscale Serve or another TLS terminator. Set a hostname (for example tralala.example.com) and
# Caddy obtains and renews the certificate itself - a public CA for a public name, its own local CA
# for a private one. Publish 443 on the host when you use that.
TRALALA_SITE_ADDRESS=:80
TRALALA_HTTPS_PORT=8443

# Port published by docker compose.
TRALALA_HTTP_PORT=8080
