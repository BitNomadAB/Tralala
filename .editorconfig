# Editor defaults for every contributor: https://editorconfig.org
# Line endings are also enforced by .gitattributes; this file makes the editor agree before Git does.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{py,pyi,mako}]
indent_size = 4

# Two trailing spaces are a hard line break in Markdown; markdownlint decides what is allowed.
[*.md]
trim_trailing_whitespace = false

# `caddy fmt` indents with tabs.
[Caddyfile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
